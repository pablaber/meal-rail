# Public browser configuration. Vite embeds these values in the built app.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Production Auth configuration. Used only by npm run config:push:production.
# Never set any of these with a VITE_ name or commit the filled .env file.
SUPABASE_ACCESS_TOKEN=sbp_replace_me
SUPABASE_PROJECT_ID=your-project-ref
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
RESEND_API_KEY=re_replace_me
SMTP_SENDER_EMAIL=sign-in@auth.example.com
